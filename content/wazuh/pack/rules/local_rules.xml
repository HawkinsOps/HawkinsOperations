<!-- Local rules -->

<group name="local,syslog,sshd,honeypot,">

  <!-- Existing: demo SSH rule -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- Existing: honeypot demo -->
  <rule id="100110" level="5">
    <match>HONEY_DEMO</match>
    <description>Honeypot deterministic demo alert (HONEY_DEMO).</description>
    <group>honeypot_demo,</group>
  </rule>

  <!-- REMOVED: 100201 (was suppressing 67027 on HO-WE-01)
       Reason: blanket suppression of process-creation alerts on primary
       Windows agent defeats telemetry visibility. Removed 2026-04-07. -->

  <!-- Existing: noise tuning for software protection -->
  <rule id="100202" level="0">
    <if_sid>60642</if_sid>
    <field name="win.system.computer">^HO-WE-01$</field>
    <description>Ignored expected software protection scheduling event on HOWE01.</description>
    <options>no_full_log</options>
    <group>noise_tuning,windows_maintenance,</group>
  </rule>

  <!-- Override 67027 to level 5 so it crosses log_alert_level threshold.
       Manager log_alert_level=5; upstream 67027 is level 3.
       Without this override, process-creation alerts never reach the indexer. -->
  <rule id="100203" level="5">
    <if_sid>67027</if_sid>
    <description>Process creation event (elevated to meet alert threshold).</description>
    <options>no_full_log</options>
    <group>process_creation,windows,</group>
  </rule>

  <!-- Elevate Sysmon EID 1 (Process Create) to level 5 so it crosses log_alert_level.
       Base rule 61603 is level 0. Without elevation, Sysmon process-creation
       events are decoded but never indexed. Added 2026-04-08 Phase 3. -->
  <rule id="100204" level="5">
    <if_sid>61603</if_sid>
    <description>Sysmon process creation event (elevated to meet alert threshold).</description>
    <options>no_full_log</options>
    <group>sysmon_event1,sysmon_process,windows,</group>
  </rule>

  <!-- TUNING 2026-04-08: Suppress PowerShell policy test script FPs from rule 92213.
       All __PSScriptPolicyTest_*.ps1 files dropped by powershell.exe into %TEMP%
       are standard PowerShell policy test behavior, not malware.
       Preserves 92213 for real executable drops in Temp. -->
  <rule id="100205" level="0">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">__PSScriptPolicyTest_.*\.ps1</field>
    <description>Suppressed: PowerShell policy test script (expected behavior, not malware).</description>
    <options>no_full_log</options>
    <group>noise_tuning,sysmon_event_11,</group>
  </rule>

  <!-- TUNING 2026-04-08: Suppress benign device class churn from rule 60227.
       Monitor/Bluetooth/HID/Audio/Printer device re-detection is normal OS behavior.
       Preserves 60227 for USB/WPD/Volume/DiskDrive/SCSIAdapter (removable media). -->
  <rule id="100206" level="0">
    <if_sid>60227</if_sid>
    <field name="win.eventdata.className" type="pcre2">^(Monitor|Bluetooth|MEDIA|HIDClass|System|Ports|AudioEndpoint|SoftwareDevice|Mouse|Keyboard|Image|WSDPrintDevice|PrintQueue|Printer|Display)$</field>
    <description>Suppressed: benign device class re-detection (not removable media).</description>
    <options>no_full_log</options>
    <group>noise_tuning,windows,</group>
  </rule>

</group>



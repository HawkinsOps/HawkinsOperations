      <!-- CommandLine Logging -->
      <Extension xsi:type="RegistrySettings">
        <RegistrySetting>
          <KeyPath>SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System\Audit</KeyPath>
          <ValueName>ProcessCreationIncludeCmdLine_Enabled</ValueName>
          <Value>1</Value>
          <Type>REG_DWORD</Type>
        </RegistrySetting>
      </Extension>
      <!-- Security Log Size -->
      <Extension xsi:type="EventLogSettings">
        <EventLog>
          <Name>Security</Name>
          <MaxSize>1048576</MaxSize>
          <RetentionDays>0</RetentionDays>
        </EventLog>
